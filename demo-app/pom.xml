<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.fastframe</groupId>
        <artifactId>fastframe-parent</artifactId>
        <version>0.22.0-SNAPSHOT</version>
    </parent>
    <artifactId>demo-app</artifactId>
    <dependencies>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-security</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-observability</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-application</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-config</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-storage</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-http-client</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-queue</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-cache</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-auth</artifactId><version>${project.version}</version></dependency>
        <dependency>
            <groupId>dev.fastframe</groupId>
            <artifactId>framework-netty</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.fastframe</groupId><artifactId>framework-database</artifactId><version>${project.version}</version>
        </dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-orm</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-migrations</artifactId><version>${project.version}</version></dependency>
        <!-- H2 only for zero-setup local demo; production drivers are opt-in. -->
        <dependency>
            <groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.3.232</version><scope>runtime</scope>
        </dependency>
        <!-- Ensures Maven reactor -am includes framework-processor; not packaged at runtime. -->
        <dependency>
            <groupId>dev.fastframe</groupId>
            <artifactId>framework-processor</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency><groupId>dev.fastframe</groupId><artifactId>framework-testing</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.fastframe</groupId>
                            <artifactId>framework-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.fastframe.demo.Application</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
