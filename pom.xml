<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.fastframe</groupId>
    <artifactId>fastframe-parent</artifactId>
    <version>0.21.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>framework-core</module>
        <module>framework-observability</module>
        <module>framework-security</module>
        <module>framework-netty</module>
        <module>framework-auth</module>
        <module>framework-cache</module>
        <module>framework-cache-redis</module>
        <module>framework-storage</module>
        <module>framework-storage-s3</module>
        <module>framework-http-client</module>
        <module>framework-queue</module>
        <module>framework-queue-redis</module>
        <module>queue-demo</module>
        <module>framework-database</module>
        <module>framework-orm</module>
        <module>framework-migrations</module>
        <module>framework-processor</module>
        <module>framework-config</module>
        <module>framework-events</module>
        <module>framework-application</module>
        <module>framework-cli</module>
        <module>framework-testing</module>
        <module>demo-app</module>
        <module>benchmarks/fastframe-app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <netty.version>4.2.19.Final</netty.version>
        <junit.version>5.12.2</junit.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration><release>${maven.compiler.release}</release></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration><useModulePath>false</useModulePath></configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
