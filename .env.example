# FastFrame v0.16 local configuration. Copy to .env; NEVER commit .env.
# The current process environment overrides these values.
APP_ENV=local
APP_DEBUG=false
FF_HOST=127.0.0.1
PORT=8080
MAX_IN_FLIGHT=256
MAX_PIPELINED=64
MAX_REQUEST_BYTES=65536
REQUEST_TIMEOUT_MS=10000
# FF_DB_URL=jdbc:h2:mem:fastframe;DB_CLOSE_DELAY=-1
# FF_DB_USER=sa
# FF_DB_PASSWORD=
# FF_RUN_MIGRATIONS=true
# FF_JWT_SECRET_B64=REPLACE_ME_WITH_32_PLUS_RANDOM_BYTES_IN_BASE64
FF_ENABLE_STORAGE_DEMO=false

# FastFrame v0.19 observability (private localhost only; OFF by default)
FF_ENABLE_METRICS=false
FF_ACCESS_LOG=false
# Graceful shutdown timeout in demo is 5 seconds.

# FastFrame v0.20 HTTP security: origin allowlist, not CSRF/auth
FF_CORS_ALLOWED_ORIGINS=
FF_CORS_ALLOW_CREDENTIALS=false
# 0 disables local per-IP rate limiting
FF_RATE_LIMIT_PER_MINUTE=0
FF_RATE_LIMIT_MAX_IPS=4096
# Set true ONLY when client-facing TLS/HTTPS is enforced by a trusted proxy
FF_HSTS=false
