# Maven output (all modules)
**/target/

# IDE / editor metadata
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS and local temp files
.DS_Store
Thumbs.db
*.log
*.swp
*.swo

# Generated benchmark measurements
benchmarks/results/
**/__pycache__/
*.pyc

# Local private storage demo files
.fastframe-files/

# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.*.example

# Local files copied into XAMPP docroot must never be publicly served.
*.env.local

# JFR recordings and profiling logs
benchmarks/jfr/
*.jfr

# Laravel benchmark project is generated from tracked route/bootstrap overlays.
benchmarks/laravel-app/runtime/
benchmarks/*-preflight.log
